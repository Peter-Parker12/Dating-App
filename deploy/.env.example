# Copy to deploy/.env and fill in. Never commit deploy/.env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=generate-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-long-and-random
# true = also create demo talents (talent1..5@cungdi.local / demo12345). Keep false in production.
SEED_DEMO=false
# From Cloudflare Zero Trust > Networks > Tunnels. Public hostname -> http://proxy:2829
CLOUDFLARE_TUNNEL_TOKEN=
