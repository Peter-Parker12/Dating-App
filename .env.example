# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=generate-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-long-and-random
# true = also create the demo talents/reviews (talent1..41@cungdi.local, customer1..4@cungdi.local).
# Their password is random (not loggable) unless you set DEMO_PASSWORD. Set SEED_DEMO=false for a real launch.
SEED_DEMO=true
DEMO_PASSWORD=

# --- Secret used to encrypt settings stored in the database (the SMTP password) ---
# Set once and keep it stable. Falls back to JWT_SECRET if empty.
SETTINGS_KEY=

# --- Email (verification codes + status notifications) ---
# You can instead configure this in the admin UI (Admin > Email settings), which takes precedence.
# Leave SMTP_HOST empty to only log emails to the API container log (development only).
MAIL_FROM=Cùng Đi <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- SMS (phone verification codes) via Twilio ---
# Leave empty to only log SMS to the API container log (development only). Users can verify with
# either their email or their phone, so SMS is optional: without it they simply use the email code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
