generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TALENT
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum PhotoKind {
  PROFILE
  GALLERY
}

enum OtpChannel {
  EMAIL
  PHONE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum SosStatus {
  OPEN
  RESOLVED
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String
  role         Role               @default(CUSTOMER)
  gender       String?
  phone        String?            @unique
  provinceCode Int?
  province     String?
  wardCode     Int?
  ward         String?
  addressLine  String?
  locale       String             @default("vi")
  status       UserStatus         @default(ACTIVE)
  kycStatus       KycStatus          @default(PENDING)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  idImageKey      String?
  studentCardKey  String?
  profileImageKey String?
  kycSubmittedAt  DateTime?
  kycReviewedAt   DateTime?
  kycReviewedBy   String?
  kycRejectReason String?
  /// Customers: activities they are looking for, shown to approved talents
  lookingFor      String[]           @default([])
  lookingForNote  String             @default("")
  createdAt    DateTime           @default(now())

  talent      TalentProfile?
  saved       SavedTalent[]
  asCustomer  Booking[]      @relation("customer")
  reviewsWritten Review[]    @relation("reviewer")
  reviewReports  ReviewReport[]
  otps           OtpCode[]
  notifications  Notification[]
  photos         Photo[]
  photoReports   PhotoReport[]
  asTalent    Booking[]      @relation("talent")
  messages    Message[]
  sosAlerts   SosAlert[]
  acks        ConductAck[]
}

model TalentProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  gender      String
  age         Int
  bio         String   @default("")
  heightCm    Int?
  style       String   @default("")
  languages   String[]
  hourlyPrice Int
  photos      String[]
  activities  String[]
  availability String  @default("")
  district    String   @default("")
  sticker     String   @default("")
  availableNow Boolean @default(false)
  published   Boolean  @default(true)
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  /// Weekly availability as "<day>:<block>" slots, e.g. "mon:evening" (see src/schedule.ts)
  schedule    String[] @default([])

  saves   SavedTalent[]
  reviews Review[]
}

/// An activity group users can offer (talents) or look for (customers). Created and managed by admins.
/// The slug never changes: profiles, preferences and bookings reference it.
model Activity {
  slug      String   @id
  nameVi    String
  nameEn    String
  icon      String   @default("sparkles")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SavedTalent {
  userId   String
  talentId String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  talent   TalentProfile @relation(fields: [talentId], references: [userId], onDelete: Cascade)

  @@id([userId, talentId])
}

model Booking {
  id          String        @id @default(cuid())
  customerId  String
  talentId    String
  customer    User          @relation("customer", fields: [customerId], references: [id])
  talent      User          @relation("talent", fields: [talentId], references: [id])
  activity    String
  date        DateTime
  startTime   String
  hours       Int
  place       String
  note        String        @default("")
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  messages Message[]
  acks     ConductAck[]
  sos      SosAlert[]
  review   Review?
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model SosAlert {
  id        String    @id @default(cuid())
  userId    String
  bookingId String?
  user      User      @relation(fields: [userId], references: [id])
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  lat       Float?
  lng       Float?
  status    SosStatus @default(OPEN)
  createdAt DateTime  @default(now())
}

model ConductAck {
  id        String   @id @default(cuid())
  userId    String
  bookingId String
  user      User     @relation(fields: [userId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  signedAt  DateTime @default(now())
}

model Review {
  id         String         @id @default(cuid())
  bookingId  String         @unique
  talentId   String
  customerId String
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  talent     TalentProfile  @relation(fields: [talentId], references: [userId], onDelete: Cascade)
  customer   User           @relation("reviewer", fields: [customerId], references: [id])
  rating     Int
  comment    String         @default("")
  reply      String?
  repliedAt  DateTime?
  hidden     Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  reports    ReviewReport[]

  @@index([talentId, createdAt])
}

model ReviewReport {
  reviewId  String
  userId    String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@id([reviewId, userId])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   OtpChannel
  target    String
  codeHash  String
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, channel, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Runtime configuration edited by admins (for example the SMTP settings). Secrets inside are encrypted.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Public profile photo (one per user) and gallery photos (up to 6). Separate from the private KYC documents.
model Photo {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         PhotoKind
  key          String
  hidden       Boolean       @default(false)
  hiddenReason String?
  hiddenBy     String?
  createdAt    DateTime      @default(now())
  reports      PhotoReport[]

  @@index([userId, kind])
}

model PhotoReport {
  photoId   String
  userId    String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@id([photoId, userId])
}
